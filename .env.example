# MINDORA Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
DEBUG=false

# Database
DATABASE_URL=sqlite:///./mindora.db
# PostgreSQL: postgresql://appuser:apppass@localhost:5432/mindora

# Security
MINDORA_ENCRYPTION_KEY=change-this-to-a-secure-random-key

# Model Provider (Nebius Token Factory)
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_BASE_URL=https://api.nebius.ai/v1
MINDORA_FAST_MODEL=nvidia/nemotron
MINDORA_REASONING_MODEL=nvidia/nemotron

# Redis
REDIS_URL=redis://localhost:6379

# Authentication (OAuth)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Monitoring
SENTRY_DSN=your-sentry-dsn-here

# Memory configuration
MEMORY_TOP_K=8
MEMORY_RELEVANCE_THRESHOLD=0.60

# Model routing thresholds
ROUTING_CONFIDENCE_LOW=0.7
ROUTING_CONFIDENCE_HIGH=0.9
